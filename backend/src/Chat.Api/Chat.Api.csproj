<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Lets a developer try a cloud model locally without its key ever entering the repo. -->
    <UserSecretsId>6e5e89a9-744d-4992-98dc-c275ce79d37d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.*" />
    <PackageReference Include="Stripe.net" Version="45.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- It holds the local signing secret and database password, which have no place in the image. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chat.Application\Chat.Application.csproj" />
    <ProjectReference Include="..\Chat.Infrastructure\Chat.Infrastructure.csproj" />
    <ProjectReference Include="..\Chat.Identity.Application\Chat.Identity.Application.csproj" />
    <ProjectReference Include="..\Chat.Identity.Infrastructure\Chat.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\Chat.Billing.Application\Chat.Billing.Application.csproj" />
    <ProjectReference Include="..\Chat.Billing.Infrastructure\Chat.Billing.Infrastructure.csproj" />
  </ItemGroup>

</Project>
